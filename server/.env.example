PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_PORT=5001
NODE_ENV=development

# Supabase (required for accounts, notifications, promos, availability)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard password (use a strong value in production)
ADMIN_PASSWORD=liyelle-admin-change-me

# Deposit settings
DEPOSIT_PERCENT=50
DEPOSIT_HOLD_HOURS=24

# Studio contact
WHATSAPP_NUMBER=17581234567
INSTAGRAM_HANDLE=theliyelleatelier
STUDIO_EMAIL=hello@theliyelleatelier.com

# Email (Gmail SMTP — admin alerts + client confirmations; use an App Password, not your login password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-studio@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Optional: defaults to STUDIO_EMAIL if unset
ADMIN_NOTIFY_EMAIL=
STUDIO_ADDRESS=Vieux-Fort, Saint Lucia
STUDIO_HOURS=Tue–Sat · 9:00 AM – 6:00 PM

# Bank of Saint Lucia (BOSL)
BOSL_ACCOUNT_NAME=The Liyelle Atelier
BOSL_ACCOUNT_NUMBER=
BOSL_BRANCH=

# CIBC FirstCaribbean
CIBC_ACCOUNT_NAME=The Liyelle Atelier
CIBC_ACCOUNT_NUMBER=
CIBC_BRANCH=

# 1st National Bank
FIRST_NATIONAL_ACCOUNT_NAME=The Liyelle Atelier
FIRST_NATIONAL_ACCOUNT_NUMBER=
FIRST_NATIONAL_BRANCH=

# Republic Bank
REPUBLIC_ACCOUNT_NAME=The Liyelle Atelier
