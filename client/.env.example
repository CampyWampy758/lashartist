# Supabase (required for sign-in, notifications, accounts)
# Use the Project URL and Publishable key from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# API URL — empty in local dev (Vite proxy handles /api).
# In production (Netlify), set to your backend host, e.g. https://liyelle-atelier-api.onrender.com
VITE_API_URL=
